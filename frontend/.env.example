# URL base de la API (sin barra final). Por defecto /api: el proxy de Vite la
# reenvía a Django, así funciona igual desde el PC y desde el celular.
# VITE_API_URL=/api

# A dónde reenvía el proxy de Vite las peticiones /api (solo en desarrollo)
# VITE_BACKEND_URL=http://127.0.0.1:8000

# URL que va dentro del QR de las entradas. Si se omite, en desarrollo se usa
# la IP del PC en la red local (http://<ip>:5173) para poder abrirla desde el celular.
# VITE_PUBLIC_URL=https://mi-tunel.trycloudflare.com
